<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.picturebackend.Mapper.UserMapper">

    <resultMap id="BaseResultMap" type="com.example.picturebackend.domain.po.User">
            <id property="id" column="id" />
            <result property="username" column="username" />
            <result property="useraccount" column="userAccount" />
            <result property="avatarurl" column="avatarUrl" />
            <result property="gender" column="gender" />
            <result property="userpassword" column="userPassword" />
            <result property="spaceId" column="spaceId"/>
            <result property="phone" column="phone" />
            <result property="userLevel" column="userLevel" />
            <result property="userStatus" column="userStatus" />
            <result property="email" column="email" />
            <result property="createtime" column="createTime" />
            <result property="updatetime" column="updateTime" />
            <result property="isdelete" column="isDelete" />
            <result property="profile" column="profile" />
    </resultMap>

    <sql id="Base_Column_List">
        id,username,userAccount,avatarUrl,gender,userPassword,
        phone,userLevel,userStatus,email,createTime,updateTime,
        isDelete,profile,spaceId
    </sql>
</mapper>
